	<parameters>
		<!--   Character Parameters   -->

		<!--   Speed                = walking speed
			   Run Multiplier       = multiplier for running-speed
			   HuntSvenDistance     = amount of tiles that enemies detect Sven and start hunting him
			   HuntTileLength       = amount of tiles that Sven is hunted when detected
			   TileLength           = amount of tiles a character walks until StandStillTime
			   TileLengtRandom      = random multiplier for TileLength
			   StandStillTime       = time (sec.) a character stands still between walking
			   StandStillTimeRandom = random multiplier for StandStillTime
			   SleepTime            = default sleeping-time for Lars and Wotan at the beginning of a level (can be adjusted per level in the editor)
	     -->

		<parameter name="GuySpeed" value="35.00"/>
		<parameter name="GuyRunMultiplier" value="2.00"/>
		<parameter name="GuyHuntSvenDistance" value="2.0"/>
		<parameter name="GuyHuntTileLength" value="10"/>

		<parameter name="GuyTileLength" value="5"/>
		<parameter name="GuyTileLengthRandom" value="2"/>
		<parameter name="GuyStandStillTime" value="4.0"/>
